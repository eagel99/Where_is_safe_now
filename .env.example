PORT=3000
LOG_LEVEL=info
DATA_DIR=./.data
TIMEZONE=Asia/Jerusalem

# Empty means the entire country. Exact Oref area names, comma separated.
AREA_FILTER=
INCLUDE_DRILLS=false

# Official sources
OREF_POLL_MS=1000
OREF_HISTORY_MS=10000
OREF_EXTENDED_HISTORY_MS=60000
REQUEST_TIMEOUT_MS=3500

# Fast sources
ENABLE_TZEVAADOM=true
ENABLE_PUSHY=false
PUSHY_ALL_SEGMENTS=true
PUSHY_SEGMENT_IDS=
PUSHY_SEGMENTS_URL=https://dist-android.meser-hadash.org.il/smart-dist/services/anonymous/segments/android?locale=iw_IL&instance=1544803905
TZEVAADOM_ID_MAP_FILE=./data/tzevaadom-id-map.json
GEOJSON_FILE=./data/areas.geojson
CITIES_METADATA_FILE=./data/cities.json

# Correlation, state and retention
CORRELATION_WINDOW_SECONDS=30
RECENT_ALERTS_LIMIT=1000
ALERT_STATE_TTL_SECONDS=600
PRE_ALERT_STATE_TTL_SECONDS=1200
END_STATE_TTL_SECONDS=60
HISTORY_CATCHUP_MINUTES=5

# 7-day ranking dashboard. Set ENABLE_RANKINGS=false to run alerts only.
# The area list is fetched from the Oref districts endpoint and cached under
# DATA_DIR; DISTRICTS_FILE is only the offline fallback snapshot.
ENABLE_RANKINGS=true
DISTRICTS_FILE=./data/districts.json
DISTRICT_REFRESH_HOURS=24
RANKING_WINDOW_DAYS=7
RANKING_CACHE_TTL_SECONDS=120
# Only used when a window exceeds the server's row cap and has to be re-walked
# one day at a time.
RANKING_REQUEST_DELAY_MS=300

# HTTP hardening.
# TRUST_PROXY=1 ONLY when a reverse proxy you control rewrites X-Forwarded-For.
TRUST_PROXY=
ALLOWED_ORIGIN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_SSE_LISTENERS=100

# Action engine. Rules are disabled in the example file.
ACTIONS_ENABLED=false
ACTIONS_FILE=./config/actions.json
ACTION_ALLOWED_HOSTS=
ACTION_HMAC_SECRET=
ALLOW_IRREVERSIBLE_ACTIONS=false
ACTION_MAX_RETRIES=3
ACTION_REQUEST_TIMEOUT_MS=5000

# Optional shared MQTT connection for action rules
ACTION_MQTT_URL=
ACTION_MQTT_USERNAME=
ACTION_MQTT_PASSWORD=

# Test endpoint is disabled unless both values are configured.
ENABLE_TEST_ENDPOINT=false
ADMIN_TOKEN=
