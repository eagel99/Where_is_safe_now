{
  "name": "pikud-haoref-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Live Pikud HaOref alert aggregation (including early warning) with a 7-day city ranking dashboard",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
