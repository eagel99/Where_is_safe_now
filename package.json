    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "mqtt": "^5.10.4",
    "pino": "^9.7.0",
    "ws": "^8.18.3"
  }
